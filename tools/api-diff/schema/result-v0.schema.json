{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jvandevelde/openapi/tools/api-diff/schema/result-v0.schema.json",
  "title": "api-diff result, schema version 0",
  "description": "Output of `api-diff --format json`. Version 0 may still change before 1.0; fields are only added within a version.",
  "type": "object",
  "required": ["schemaVersion", "tool", "profile", "compared", "state", "counts", "findings"],
  "properties": {
    "schemaVersion": { "const": 0 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "const": "api-diff" }, "version": { "type": "string" } }
    },
    "profile": { "enum": ["wire", "sdk"] },
    "compared": {
      "type": "object",
      "required": ["base", "revision"],
      "properties": { "base": { "$ref": "#/$defs/side" }, "revision": { "$ref": "#/$defs/side" } }
    },
    "state": { "enum": ["no-changes", "compatible", "breaking"] },
    "counts": {
      "type": "object",
      "required": ["total", "bySeverity", "byKind", "byRule"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "bySeverity": {
          "type": "object",
          "required": ["error", "warn", "info"],
          "additionalProperties": { "type": "integer" }
        },
        "byKind": {
          "type": "object",
          "required": ["wire", "sdk", "docs"],
          "additionalProperties": { "type": "integer" }
        },
        "byRule": { "type": "object", "additionalProperties": { "type": "integer" } },
        "acknowledged": { "type": "integer", "minimum": 0, "description": "Findings covered by an acknowledgement (included in the other counts)." }
      }
    },
    "advice": {
      "description": "Semver advice, when both versions are semver.",
      "type": "object",
      "required": ["needed", "actual", "ok", "breaking"],
      "properties": {
        "needed": { "enum": ["none", "patch", "minor", "major"] },
        "actual": { "enum": ["none", "patch", "minor", "major"] },
        "ok": { "type": "boolean" },
        "because": { "type": "string" },
        "breaking": { "type": "integer", "minimum": 0 }
      }
    },
    "snippets": {
      "description": "Source lines around each finding, by finding ID; only when asked for (the explore report).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "base": { "$ref": "#/$defs/snippet" }, "revision": { "$ref": "#/$defs/snippet" } }
      }
    },
    "operations": {
      "description": "The operations findings mention, by subject (e.g. GET /pets), for grouping and labels.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tags"],
        "properties": { "operationId": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "summary": { "type": "string" } }
      }
    },
    "policy": {
      "description": "The policy file used, and the SHA-256 of its contents.",
      "type": "object",
      "required": ["file", "sha256"],
      "properties": { "file": { "type": "string" }, "sha256": { "type": "string" } }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "snippet": {
      "type": "object",
      "required": ["file", "start", "line", "lines"],
      "properties": { "file": { "type": "string" }, "start": { "type": "integer" }, "line": { "type": "integer" }, "lines": { "type": "array", "items": { "type": "string" } } }
    },
    "side": {
      "type": "object",
      "required": ["input", "file", "version"],
      "properties": {
        "input": { "type": "string", "description": "The input as given, e.g. main:openapi.yaml." },
        "file": { "type": "string", "description": "Display name of the root file." },
        "openapi": { "type": "string" },
        "version": { "type": "string", "description": "info.version, or 'unknown'." },
        "sha256": { "type": "string" },
        "commit": { "type": "string", "description": "Resolved commit SHA for git inputs." },
        "title": { "type": "string", "description": "info.title." },
        "versionSource": { "type": "string", "description": "Where version came from, e.g. info.version, x-api-version or command line." },
        "labels": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Version labels from the policy or the command line; commit for git inputs." }
      }
    },
    "location": {
      "type": "object",
      "required": ["file", "pointer"],
      "properties": {
        "file": { "type": "string" },
        "pointer": { "type": "string", "description": "JSON Pointer in that file." },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "rule", "baseRule", "kind", "severity", "severitySource", "subject", "message", "details"],
      "properties": {
        "id": { "type": "string", "description": "Stable ID: the same change in the same place always gets the same ID." },
        "rule": { "type": "string", "description": "Most specific rule ID, e.g. query-parameter-removed." },
        "baseRule": { "type": "string", "description": "Rule ID without location or direction." },
        "kind": { "enum": ["wire", "sdk", "docs"] },
        "severity": { "enum": ["error", "warn", "info"] },
        "severitySource": { "type": "string" },
        "subject": { "type": "string", "description": "e.g. 'GET /pets/{id}' or 'document'." },
        "message": { "type": "string" },
        "base": { "$ref": "#/$defs/location" },
        "revision": { "$ref": "#/$defs/location" },
        "details": { "type": "object" },
        "impact": { "type": "array", "items": { "type": "string" } },
        "exclusions": { "description": "Policy exclusion sets the finding belongs to; reports can leave them out.", "type": "array", "items": { "type": "string" } },
        "acknowledged": {
          "description": "Set when an acknowledgement covers the finding: reported, but it doesn't fail CI or count towards state.",
          "type": "object",
          "required": ["reason", "expires", "file"],
          "properties": { "reason": { "type": "string" }, "owner": { "type": "string" }, "expires": { "type": "string" }, "file": { "type": "string" } }
        }
      }
    }
  }
}
