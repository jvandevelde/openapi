{
  "name": "api-diff",
  "version": "0.12.0",
  "private": true,
  "description": "Compare two OpenAPI documents and decide which changes break clients.",
  "type": "module",
  "bin": {
    "api-diff": "./bin/api-diff.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "bench": "node test/bench/bench.ts",
    "docs": "node scripts/rule-docs.ts",
    "bundle": "node scripts/bundle.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "jsonc-parser": "^3.3.1",
    "mustache": "4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.3",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
